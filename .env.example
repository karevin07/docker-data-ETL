# ================================
# Docker Data ETL Platform - Environment Variables
# ================================
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# --------------------------------
# Airflow Security Keys
# --------------------------------
# Fernet Key: 用於加密 Airflow 資料庫中的敏感資料
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=olDpdQh84IPSamGzX3HuJQ==

# Webserver Secret Key: 用於 Flask session 加密
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=olDpdQh84IPSamGzX3HuJQ==

# --------------------------------
# Database Configuration
# --------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --------------------------------
# Spark Configuration
# --------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# --------------------------------
# 其他配置
# --------------------------------
# 時區設定 (可選)
# TZ=Asia/Taipei
