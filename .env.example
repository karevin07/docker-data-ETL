# ================================
# Docker Data ETL Platform - Environment Variables
# ================================
# ⚠️  SECURITY WARNING: You MUST change all default values before deploying!
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# --------------------------------
# Airflow Admin User (REQUIRED)
# --------------------------------
# ⚠️  MUST be set - the system will refuse to start without these
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme_secure_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User

# --------------------------------
# Airflow Security Keys (REQUIRED)
# --------------------------------
# ⚠️  Generate secure keys before deploying!
# Fernet Key: 用於加密 Airflow 資料庫中的敏感資料
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=PLEASE_GENERATE_A_NEW_KEY

# Webserver Secret Key: 用於 Flask session 加密
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=PLEASE_GENERATE_A_NEW_KEY

# --------------------------------
# JupyterLab Security (OPTIONAL)
# --------------------------------
# JupyterLab Token: 用於存取 JupyterLab 介面
# 若未設定，系統會自動生成並顯示在 logs 中
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
# JUPYTER_TOKEN=your_secure_token_here

# --------------------------------
# Database Configuration
# --------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --------------------------------
# Spark Configuration
# --------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# --------------------------------
# 其他配置
# --------------------------------
# 時區設定 (可選)
# TZ=Asia/Taipei
